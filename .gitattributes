# Force LF regardless of local core.autocrlf. Without this, files edited on
# a Windows checkout with autocrlf=true silently gain CRLF line endings;
# for shell scripts run inside Linux containers this can break parsing
# (e.g. a trailing \r appended to `set -e`), and for scripts invoked
# directly (not via `sh script.sh`) the shebang line itself breaks.
*.sh text eol=lf
*.py text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
entrypoint.sh text eol=lf
