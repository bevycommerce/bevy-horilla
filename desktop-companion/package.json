{
  "name": "bevy-workspace-desktop",
  "version": "0.1.0",
  "description": "Bevy Workspace Desktop Companion: tray app for attendance, daily updates and reminders.",
  "main": "src/main/main.js",
  "author": "Bevy Commerce",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "build:win": "electron-builder --win nsis zip --x64 --publish never",
    "build:mac": "electron-builder --mac dmg --publish never",
    "make-icons": "node scripts/make-icons.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.bevycommerce.workspace",
    "productName": "Bevy Workspace",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Bevy Workspace"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "publish": null
  }
}
